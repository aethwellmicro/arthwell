// Prisma schema for Internal Collection & Loan Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PG_DATABASE_URL")
  directUrl = env("PG_DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("COLLECTION_EMPLOYEE") // ADMIN, BRANCH_MANAGER, ACCOUNTANT, COLLECTION_EMPLOYEE
  employeeCode  String?  @unique
  phone         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collections   Collection[]
  customers     Customer[]   @relation("CreatedBy")
  accounts      Account[]    @relation("CreatedBy")
  groups        Group[]      @relation("CreatedBy")
  approvedCustomers Customer[] @relation("ApprovedBy")
  rejectedCustomers Customer[] @relation("RejectedBy")
  cancelledCustomers Customer[] @relation("CancelledBy")
  auditLogs     AuditLog[]
  notifications Notification[]
  sessions      Session[]

  // Business date & bank deposit relations
  openedBusinessDates   BusinessDate[] @relation("OpenedBy")
  closedBusinessDates   BusinessDate[] @relation("ClosedBy")
  reopenedBusinessDates BusinessDate[] @relation("ReopenedBy")
  authorizedEODs        BusinessDate[] @relation("AuthorizedBy")
  bankDeposits          BankDeposit[]  @relation("CreatedBy")
  investments           Investment[]   @relation("CreatedBy")
  expenses              Expense[]      @relation("CreatedBy")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Group {
  id          String   @id @default(cuid())
  groupId     String   @unique // GRP-0001
  name        String
  branch      String   @default("Main Branch")
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])

  customers   Customer[]

  @@index([status])
  @@index([branch])
}

model LoanProduct {
  id               String    @id @default(cuid())
  productCode      String    @unique // e.g. AMF-WL-20000
  name             String
  loanType         String    @default("JLG / Group Loan")
  principal        Decimal
  interestRate     Decimal
  interestBasis    String    @default("YEARLY") // YEARLY, MONTHLY, FLAT_PERIOD
  interestMethod   String    @default("REDUCING") // REDUCING, FLAT
  tenure           Int       // e.g. 25, 50
  frequency        String    @default("WEEKLY") // WEEKLY, MONTHLY, DAILY
  emiAmount        Decimal
  savingsAmount    Decimal   @default(100)
  processingFee    Decimal   @default(0)
  insurancePremium Decimal   @default(0)
  status           String    @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts         Account[]

  @@index([status])
  @@index([productCode])
}

model Customer {
  id              String   @id @default(cuid())
  customerId      String   @unique // CUST-0001
  fullName        String
  primaryMobile   String
  alternateMobile String?
  address         String?
  city            String?
  area            String?
  occupation      String?
  referenceName   String?
  referenceMobile String?
  photoUrl        String?
  idType          String? // Aadhaar, PAN, Voter ID, etc.
  idNumber        String?
  amount          Float    @default(0) // Loan/credit amount requested at registration
  branch          String   @default("Main Branch")
  status          String   @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, APPROVED, REJECTED, CANCELLED, READY_FOR_DISBURSEMENT, DISBURSED, ACTIVE, CLOSED, BLOCKED

  groupId         String?
  group           Group?   @relation(fields: [groupId], references: [id])

  approvedById    String?
  approvedBy      User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?

  rejectedById    String?
  rejectedBy      User?    @relation("RejectedBy", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?

  cancelledById   String?
  cancelledBy     User?    @relation("CancelledBy", fields: [cancelledById], references: [id])
  cancelledAt     DateTime?
  cancellationReason String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String
  createdBy       User     @relation("CreatedBy", fields: [createdById], references: [id])

  accounts        Account[]
  collections     Collection[]

  @@index([groupId])
  @@index([status])
  @@index([branch])
}

model BusinessDate {
  id                    String   @id @default(cuid())
  businessDate          DateTime @unique // e.g. 2026-09-23 00:00:00
  status                String   @default("OPEN") // OPEN, RECONCILIATION_PENDING, CLOSED, REOPENED
  
  openedAt              DateTime @default(now())
  openedById            String
  openedBy              User     @relation("OpenedBy", fields: [openedById], references: [id])

  closedAt              DateTime?
  closedById            String?
  closedBy              User?    @relation("ClosedBy", fields: [closedById], references: [id])

  reopenedAt            DateTime?
  reopenedById          String?
  reopenedBy            User?    @relation("ReopenedBy", fields: [reopenedById], references: [id])
  reopenReason          String?

  openingCash           Decimal  @default(0)
  closingCash           Decimal  @default(0) // Expected or reconciled closing cash
  actualCashInHand      Decimal  @default(0) // Entered physical cash during EOD
  cashDifference        Decimal  @default(0) // actual - expected
  differenceReason      String?

  authorizedById        String?
  authorizedBy          User?    @relation("AuthorizedBy", fields: [authorizedById], references: [id])

  reconciliationStatus  String   @default("PENDING") // PENDING, BALANCED, DIFFERENCE_RESOLVED
  notes                 String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  collections           Collection[]
  accounts              Account[]     // Disbursements executed on this business date
  bankDeposits          BankDeposit[]
  investments           Investment[]  // Capital & Investor Inflows credited to this business date
  expenses              Expense[]     // Expenditures & Outflows debited from this business date

  @@index([status])
  @@index([businessDate])
}

model BankDeposit {
  id              String       @id @default(cuid())
  depositNumber   String       @unique // DEP-0001
  businessDateId  String
  businessDate    BusinessDate @relation(fields: [businessDateId], references: [id])

  bankAccount     String       // e.g. HDFC Bank - 50200012345678
  amount          Decimal
  referenceNumber String?      // Bank challan / transaction ref
  depositDate     DateTime     // Date recorded at bank
  notes           String?

  createdById     String
  createdBy       User         @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([businessDateId])
  @@index([depositDate])
}

model Account {
  id                String   @id @default(cuid())
  accountNumber     String   @unique // LN-0001
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])

  productId         String?
  product           LoanProduct? @relation(fields: [productId], references: [id])

  businessDateId    String?
  businessDate      BusinessDate? @relation(fields: [businessDateId], references: [id])

  principal         Decimal  
  interestRate      Decimal  
  interestType      String   // FLAT, REDUCING
  interestPeriod    String   // MONTHLY, YEARLY, FLAT_PERIOD
  tenure            Int      // number of installments
  installmentFreq   String   // DAILY, WEEKLY, MONTHLY
  installmentAmount Decimal  
  totalPayable      Decimal  
  totalInterest     Decimal  

  savingsAmount     Decimal  @default(0)
  processingFee     Decimal  @default(0)
  insurancePremium  Decimal  @default(0)

  startDate        DateTime
  firstDueDate     DateTime
  maturityDate     DateTime
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, OVERDUE, CLOSED
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String
  createdBy        User     @relation("CreatedBy", fields: [createdById], references: [id])

  installments     Installment[]
  collections      Collection[]

  @@index([customerId])
  @@index([productId])
  @@index([businessDateId])
}

model Installment {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  installNo      Int
  dueDate        DateTime
  amount         Decimal  
  principalPart  Decimal  @default(0)
  interestPart   Decimal  @default(0)
  savingsPart    Decimal  @default(0)
  paidAmount     Decimal  @default(0)
  paidPrincipal  Decimal  @default(0)
  paidInterest   Decimal  @default(0)
  paidSavings    Decimal  @default(0)
  balance        Decimal  @default(0)
  status         String   @default("PENDING") // PENDING, PAID, PARTIAL, OVERDUE, WAIVED, CANCELLED
  paidDate       DateTime?
  createdAt      DateTime @default(now())

  @@index([accountId])
  @@index([dueDate])
}

model Collection {
  id                  String   @id @default(cuid())
  receiptNumber       String   @unique // RCP-0001
  customerId          String
  customer            Customer @relation(fields: [customerId], references: [id])
  accountId           String
  account             Account  @relation(fields: [accountId], references: [id])

  businessDateId      String?
  businessDate        BusinessDate? @relation(fields: [businessDateId], references: [id])

  collectionDate      DateTime
  amount              Decimal  
  paymentMode         String   // CASH, UPI, BANK, OTHER
  collectedById       String
  collectedBy         User     @relation(fields: [collectedById], references: [id])

  previousOutstanding Decimal  
  currentOutstanding  Decimal  
  allocatedPrincipal  Decimal  @default(0)
  allocatedInterest   Decimal  @default(0)
  remarks             String?
  status              String   @default("SUCCESSFUL") // SUCCESSFUL, REVERSED, CANCELLED
  reversalReason      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  receipt             Receipt?
  notification        Notification?

  @@index([customerId])
  @@index([accountId])
  @@index([businessDateId])
  @@index([collectionDate])
}

model Receipt {
  id            String   @id @default(cuid())
  collectionId  String   @unique
  collection    Collection @relation(fields: [collectionId], references: [id])
  receiptNumber String   @unique
  branchName    String   @default("Main Branch")
  printCount    Int      @default(0)
  createdAt     DateTime @default(now())
}

model Notification {
  id           String   @id @default(cuid())
  collectionId String?  @unique
  collection   Collection? @relation(fields: [collectionId], references: [id])
  customerId   String?
  type         String   // PAYMENT_CONFIRMATION, DUE_REMINDER, OVERDUE_REMINDER, ACCOUNT_COMPLETION
  message      String
  recipient    String
  status       String   @default("PENDING") // PENDING, SENT, FAILED
  createdAt    DateTime @default(now())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])

  @@index([collectionId])
  @@index([customerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // CREATE, UPDATE, DELETE, REVERSE, LOGIN, LOGOUT, EOD_STARTED, EOD_CLOSED, etc.
  entity    String   // CUSTOMER, ACCOUNT, COLLECTION, GROUP, BUSINESS_DATE, BANK_DEPOSIT, etc.
  entityId  String?
  oldValue  String?
  newValue  String?
  reason    String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityId])
  @@index([action])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Investment {
  id              String       @id @default(cuid())
  investmentNumber String      @unique // INV-0001
  businessDateId  String
  businessDate    BusinessDate @relation(fields: [businessDateId], references: [id])

  investorName    String       // Name of investor, director, or institution
  investorPhone   String?
  investmentType  String       // DIRECTOR_MEMBER, INVESTOR_DEPOSIT, CAPITAL_INVESTMENT, INSTITUTIONAL, OTHER
  amount          Decimal
  paymentMode     String       // CASH, BANK, UPI, CHEQUE, OTHER
  investmentDate  DateTime     // Date investment received
  
  termMonths      Int?         // Investment term/tenure in months
  interestRate    Decimal?     // Annual or term interest rate %
  maturityDate    DateTime?    // Projected return/maturity date
  interestPaid    Decimal      @default(0) // Total interest paid to date
  status          String       @default("ACTIVE") // ACTIVE, MATURED, CLOSED, CANCELLED
  remarks         String?

  createdById     String
  createdBy       User         @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([businessDateId])
  @@index([investmentDate])
  @@index([investmentType])
  @@index([status])
}

model Expense {
  id              String       @id @default(cuid())
  expenseNumber   String       @unique // EXP-0001
  businessDateId  String
  businessDate    BusinessDate @relation(fields: [businessDateId], references: [id])

  expenseType     String       // INVESTMENT_INTEREST, OFFICE_EXPENSE, EMPLOYEE_SALARY, TRAVELING, STATIONERY_ADMIN, UTILITIES, RENT, OTHER
  particulars     String       // Description / bill / voucher detail
  amount          Decimal
  paymentMode     String       // CASH, BANK, UPI, CHEQUE, OTHER
  expenseDate     DateTime     // Date expenditure incurred
  recipientName   String?      // Vendor / Employee / Party name
  voucherNumber   String?      // Physical voucher or receipt ref
  remarks         String?
  status          String       @default("CONFIRMED") // CONFIRMED, CANCELLED

  createdById     String
  createdBy       User         @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([businessDateId])
  @@index([expenseDate])
  @@index([expenseType])
  @@index([status])
}


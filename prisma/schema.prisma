// Prisma schema for Internal Collection & Loan Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PG_DATABASE_URL")
  directUrl = env("PG_DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("COLLECTION_EMPLOYEE") // ADMIN, BRANCH_MANAGER, ACCOUNTANT, COLLECTION_EMPLOYEE
  employeeCode  String?  @unique
  phone         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collections   Collection[]
  customers     Customer[]   @relation("CreatedBy")
  accounts      Account[]    @relation("CreatedBy")
  groups        Group[]      @relation("CreatedBy")
  approvedCustomers Customer[] @relation("ApprovedBy")
  rejectedCustomers Customer[] @relation("RejectedBy")
  cancelledCustomers Customer[] @relation("CancelledBy")
  auditLogs     AuditLog[]
  notifications Notification[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Group {
  id          String   @id @default(cuid())
  groupId     String   @unique // GRP-0001
  name        String
  branch      String   @default("Main Branch")
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])

  customers   Customer[]

  @@index([status])
  @@index([branch])
}

model Customer {
  id              String   @id @default(cuid())
  customerId      String   @unique // CUST-0001
  fullName        String
  primaryMobile   String
  alternateMobile String?
  address         String?
  city            String?
  area            String?
  occupation      String?
  referenceName   String?
  referenceMobile String?
  photoUrl        String?
  idType          String? // Aadhaar, PAN, Voter ID, etc.
  idNumber        String?
  amount          Float    @default(0) // Loan/credit amount requested at registration
  branch          String   @default("Main Branch")
  status          String   @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, APPROVED, REJECTED, CANCELLED, READY_FOR_DISBURSEMENT, DISBURSED, ACTIVE, CLOSED, BLOCKED

  groupId         String?
  group           Group?   @relation(fields: [groupId], references: [id])

  approvedById    String?
  approvedBy      User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?

  rejectedById    String?
  rejectedBy      User?    @relation("RejectedBy", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?

  cancelledById   String?
  cancelledBy     User?    @relation("CancelledBy", fields: [cancelledById], references: [id])
  cancelledAt     DateTime?
  cancellationReason String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String
  createdBy       User     @relation("CreatedBy", fields: [createdById], references: [id])

  accounts        Account[]
  collections     Collection[]

  @@index([groupId])
  @@index([status])
  @@index([branch])
}

model Account {
  id                String   @id @default(cuid())
  accountNumber     String   @unique // LN-0001
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])

  principal         Decimal  
  interestRate      Decimal  
  interestType      String   // FLAT, REDUCING
  interestPeriod    String   // MONTHLY, YEARLY, FLAT_PERIOD
  tenure            Int      // number of installments
  installmentFreq   String   // DAILY, WEEKLY, MONTHLY
  installmentAmount Decimal  
  totalPayable      Decimal  
  totalInterest     Decimal  

  startDate        DateTime
  firstDueDate     DateTime
  maturityDate     DateTime
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, OVERDUE, CLOSED
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String
  createdBy        User     @relation("CreatedBy", fields: [createdById], references: [id])

  installments     Installment[]
  collections      Collection[]

  @@index([customerId])
}

model Installment {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  installNo  Int
  dueDate    DateTime
  amount     Decimal  
  paidAmount Decimal  @default(0) 
  status     String   @default("PENDING") // PENDING, PAID, PARTIAL, OVERDUE
  paidDate   DateTime?
  createdAt  DateTime @default(now())

  @@index([accountId])
}

model Collection {
  id                  String   @id @default(cuid())
  receiptNumber       String   @unique // RCP-0001
  customerId          String
  customer            Customer @relation(fields: [customerId], references: [id])
  accountId           String
  account             Account  @relation(fields: [accountId], references: [id])

  collectionDate      DateTime
  amount              Decimal  
  paymentMode         String   // CASH, UPI, BANK, OTHER
  collectedById       String
  collectedBy         User     @relation(fields: [collectedById], references: [id])

  previousOutstanding Decimal  
  currentOutstanding  Decimal  
  remarks             String?
  status              String   @default("SUCCESSFUL") // SUCCESSFUL, REVERSED, CANCELLED
  reversalReason      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  receipt             Receipt?
  notification        Notification?

  @@index([customerId])
  @@index([accountId])
}

model Receipt {
  id            String   @id @default(cuid())
  collectionId  String   @unique
  collection    Collection @relation(fields: [collectionId], references: [id])
  receiptNumber String   @unique
  branchName    String   @default("Main Branch")
  printCount    Int      @default(0)
  createdAt     DateTime @default(now())
}

model Notification {
  id           String   @id @default(cuid())
  collectionId String?  @unique
  collection   Collection? @relation(fields: [collectionId], references: [id])
  customerId   String?
  type         String   // PAYMENT_CONFIRMATION, DUE_REMINDER, OVERDUE_REMINDER, ACCOUNT_COMPLETION
  message      String
  recipient    String
  status       String   @default("PENDING") // PENDING, SENT, FAILED
  createdAt    DateTime @default(now())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])

  @@index([collectionId])
  @@index([customerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // CREATE, UPDATE, DELETE, REVERSE, LOGIN, LOGOUT
  entity    String   // CUSTOMER, ACCOUNT, COLLECTION, USER, etc.
  entityId  String?
  oldValue  String?
  newValue  String?
  reason    String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
